{
  "name": "blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "astro check && pnpm --filter video run typecheck",
    "video:studio": "pnpm --filter video run studio",
    "video:storyboard": "pnpm --filter video run storyboard",
    "video:voice": "pnpm --filter video run voice",
    "video:render": "pnpm --filter video run render",
    "video:upload": "pnpm --filter video run upload",
    "video:generate": "pnpm --filter video run generate",
    "check": "astro check",
    "check:dist": "node scripts/ci/check-dist.mjs dist content/posts",
    "diagrams": "node scripts/render-diagrams.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-text": "^4.0.3",
    "image-size": "^2.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "hast-util-to-html": "^9.0.6",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.8.1"
}
