    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.6",
    "remotion": "^4.0.541",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
