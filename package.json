{
  "name": "blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "astro check && tsc --noEmit -p video",
    "video:studio": "remotion studio video/src/index.ts",
    "video:storyboard": "VIDEO_STEP=storyboard tsx video/src/cli/generate.ts",
    "video:voice": "VIDEO_STEP=voice tsx video/src/cli/generate.ts",
    "video:render": "VIDEO_STEP=render tsx video/src/cli/generate.ts",
    "video:upload": "VIDEO_STEP=upload tsx video/src/cli/generate.ts",
    "video:generate": "VIDEO_STEP=all tsx video/src/cli/generate.ts",
    "check": "astro check",
    "check:dist": "node scripts/ci/check-dist.mjs dist content/posts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.3",
    "image-size": "^2.1.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^1.9.4",
