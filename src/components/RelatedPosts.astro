---
import Tag from "@/components/Tag"
import type { Post } from "@/lib/post-types"
import { format, parseISO } from "date-fns"
import { ArrowRight, BookOpen, Calendar, TrendingUp } from "lucide-react"

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <div class="not-prose mt-12 border-t border-border pt-8">
      <div class="mb-6">
        <h3 class="text-xl font-semibold text-foreground">Related Posts</h3>
        <p class="text-sm text-muted-foreground">
          Continue reading with these related articles
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/posts/${post.slug}`}
            class="group block rounded-lg border border-border p-4 no-underline transition-colors duration-150 hover:border-accent/50"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2 text-xs text-muted-foreground">
                  <div class="flex items-center space-x-1">
                    <Calendar className="h-3 w-3" />
                    <time datetime={post.date}>
                      {format(parseISO(post.date), "MMM d, yyyy")}
                    </time>
                  </div>
                  <div class="flex items-center space-x-1">
                    <BookOpen className="h-3 w-3" />
                    <span>{post.readingTime.text}</span>
                  </div>
                </div>
              </div>

              {post.series && (
                <div class="inline-flex items-center rounded-full bg-accent-muted/50 px-2 py-1 text-xs font-medium text-foreground">
                  <TrendingUp className="mr-1 h-3 w-3" />
                  {post.series}
                  {post.part && (
                    <span class="ml-1 rounded-full bg-accent-muted/70 px-1.5 py-0.5 text-xs font-bold">
                      Part {post.part}
                    </span>
                  )}
                </div>
              )}

              <div>
                <h4 class="line-clamp-2 text-base font-semibold text-foreground group-hover:text-accent">
                  {post.title}
                </h4>
                <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">
                  {post.excerpt}
                </p>
              </div>

              {post.tags.length > 0 && (
                <div class="flex flex-wrap gap-1">
                  {post.tags.slice(0, 3).map((tag) => (
                    <Tag text={tag} asLink={false} />
                  ))}
                  {post.tags.length > 3 && (
                    <span class="inline-flex items-center rounded-full bg-surface px-2 py-0.5 text-xs font-medium text-muted-foreground">
                      +{post.tags.length - 3} more
                    </span>
                  )}
                </div>
              )}

              <div class="pt-2">
                <div class="inline-flex items-center text-sm font-medium text-accent no-underline transition-all duration-200 group-hover:text-accent-hover">
                  Read article
                  <ArrowRight className="ml-1 h-3 w-3 transition-transform group-hover:translate-x-1" />
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}
