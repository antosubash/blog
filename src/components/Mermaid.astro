<script>
  // Renders the diagram cards produced by src/lib/markdown/mermaid.ts.
  // mermaid is only downloaded on pages that have a diagram.
  const diagrams = document.querySelectorAll<HTMLElement>("[data-mermaid]")
  if (diagrams.length > 0) {
    const { default: mermaid } = await import("mermaid")
    mermaid.initialize({
      startOnLoad: false,
      theme: "default",
      securityLevel: "loose",
      fontFamily: "inherit",
      fontSize: 14,
    })
    let n = 0
    for (const card of diagrams) {
      const source =
        card.querySelector("[data-mermaid-source]")?.textContent?.trim() ?? ""
      try {
        const { svg } = await mermaid.render(`mermaid-${n++}`, source)
        // The SVG is generated locally from our own MDX content.
        const parsed = new DOMParser().parseFromString(svg, "image/svg+xml")
        const wrap = document.createElement("div")
        wrap.className = "flex justify-center"
        wrap.appendChild(parsed.documentElement)
        card.querySelector(".mermaid-loading")?.replaceWith(wrap)
      } catch (err) {
        console.error("Mermaid rendering error:", err)
        card.className = "rounded-lg border border-destructive/30 bg-destructive/10 p-4 my-6"
        const title = document.createElement("h3")
        title.className = "mb-2 text-lg font-semibold text-destructive"
        title.textContent = "Mermaid Diagram Error"
        const msg = document.createElement("p")
        msg.className = "text-sm text-destructive/80"
        msg.textContent = err instanceof Error ? err.message : "Failed to render diagram"
        card.querySelector(".mermaid-loading")?.replaceWith(title, msg)
      }
    }
  }
</script>
