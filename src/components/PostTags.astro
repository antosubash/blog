---
import Link from "@/components/Link.astro"
import { ChevronUp } from "lucide-react"

interface Props {
  tags: string[]
}

const { tags } = Astro.props
---

<div class="fixed bottom-6 right-6 z-40 space-y-3">
  <button
    type="button"
    aria-label="Scroll to top"
    class="hidden h-12 w-12 items-center justify-center rounded-full bg-card shadow-lg transition-all duration-200 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70"
    data-scroll-top
    data-scroll-top-far
  >
    <ChevronUp className="h-5 w-5 text-muted-foreground" />
  </button>
</div>

{
  tags.length > 0 && (
    <div class="mb-8">
      <h3 class="mb-3 text-sm font-medium text-muted-foreground">Tags:</h3>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Link
            href={`/tags/${tag}`}
            class="inline-flex items-center rounded-full bg-accent-muted/50 px-3 py-1 text-xs font-medium text-foreground transition-colors hover:bg-accent-muted/70"
          >
            #{tag}
          </Link>
        ))}
      </div>
    </div>
  )
}

<script>
  const button = document.querySelector<HTMLElement>("[data-scroll-top-far]")
  const onScroll = () => {
    const show = window.scrollY > 400
    button?.classList.toggle("hidden", !show)
    button?.classList.toggle("flex", show)
  }
  window.addEventListener("scroll", onScroll, { passive: true })
  onScroll()
</script>
