---
import { getCollection } from "astro:content"
import {
  type Project,
  featuredProjects,
  sampleProjects,
} from "@/config/projectsData"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { type RepoStats, formatStats, getRepoStats } from "@/lib/github"
import { getAllPosts } from "@/lib/posts"
import { type PostWithBody, relatedPosts } from "@/lib/projects"
import { genPageMetadata } from "@/lib/seo"

const meta = genPageMetadata({
  title: "Projects",
  description:
    "Open-source projects by Anto Subash: SimpleModule, ABP React, ABP Microservice, the ABP single-layer template, and the sample apps behind the blog posts.",
})

// Related posts come from the posts that link to a project's repos.
const bodies = new Map(
  (await getCollection("posts")).map((e) => [e.id, e.body ?? ""])
)
const posts: PostWithBody[] = (await getAllPosts()).map((post) => ({
  post,
  body: bodies.get(post.slug) ?? "",
}))

type Repo = { name: string; url: string; stats: RepoStats | null }
const withRepos = async (project: Project, limit: number) => ({
  ...project,
  repoInfo: await Promise.all(
    project.repos.map(
      async (full): Promise<Repo> => ({
        name: full.split("/")[1],
        url: `https://github.com/${full}`,
        stats: await getRepoStats(full),
      })
    )
  ),
  related: relatedPosts(
    [...project.repos, ...(project.aliases ?? [])],
    posts,
    limit,
    project.posts
  ),
})

const featured = await Promise.all(featuredProjects.map((p) => withRepos(p, 3)))
const samples = await Promise.all(sampleProjects.map((p) => withRepos(p, 1)))

const external = { target: "_blank", rel: "noopener noreferrer" }
const button =
  "inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground transition-colors duration-150 hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70"
---

<BaseLayout meta={meta}>
  <div class="mx-auto max-w-4xl px-5 sm:px-6">
    <div class="pb-8 pt-12 sm:pt-16">
      <h1
        class="font-display text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
      >
        Projects
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-muted-foreground">
        Frameworks, templates and sample apps I build and maintain. Most of
        them come with posts on this blog.
      </p>
    </div>

    <section aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="sr-only">Featured projects</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          featured.map((project) => (
            <article
              id={project.slug}
              class="flex flex-col rounded-lg border border-border bg-surface p-6 transition-colors duration-150 hover:border-accent/50"
            >
              <h3 class="font-display text-xl font-semibold text-foreground">
                <a
                  href={project.repoInfo[0].url}
                  {...external}
                  class="transition-colors duration-150 hover:text-accent"
                >
                  {project.title}
                </a>
              </h3>
              <p class="mt-1 text-sm font-medium text-accent">
                {project.tagline}
              </p>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">
                {project.description}
              </p>

              <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies">
                {project.tags.map((tag) => (
                  <li class="rounded-md bg-accent-muted/50 px-2 py-0.5 text-xs font-medium text-muted-foreground">
                    {tag}
                  </li>
                ))}
              </ul>

              <ul class="mt-4 space-y-1 text-sm">
                {project.repoInfo.map((repo) => (
                  <li class="flex flex-wrap items-baseline gap-x-2">
                    <a
                      href={repo.url}
                      {...external}
                      class="font-mono text-foreground underline decoration-border underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
                    >
                      {repo.name}
                    </a>
                    {repo.stats && (
                      <span class="text-muted-foreground">
                        {formatStats(repo.stats)}
                      </span>
                    )}
                  </li>
                ))}
              </ul>

              {project.related.length > 0 && (
                <div class="mt-4">
                  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Read more
                  </p>
                  <ul class="mt-1.5 space-y-1">
                    {project.related.map((post) => (
                      <li class="text-sm">
                        <a
                          href={post.postUrl}
                          class="line-clamp-1 text-foreground transition-colors duration-150 hover:text-accent"
                        >
                          {post.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="mt-auto flex flex-wrap gap-2 pt-5">
                <a href={project.repoInfo[0].url} {...external} class={button}>
                  GitHub
                </a>
                {(project.links ?? []).map((link) => (
                  <a href={link.href} {...external} class={button}>
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="samples-heading" class="mt-14 pb-12">
      <h2
        id="samples-heading"
        class="font-display text-2xl font-semibold tracking-tight text-foreground"
      >
        Samples
      </h2>
      <p class="mt-2 text-muted-foreground">
        Smaller repos that go with a post: clone one and follow along.
      </p>
      <ul class="mt-4 divide-y divide-border">
        {
          samples.map((sample) => {
            const repo = sample.repoInfo[0]
            const post = sample.related[0]
            return (
              <li id={sample.slug} class="py-4">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <a
                    href={repo.url}
                    {...external}
                    class="font-mono font-medium text-foreground transition-colors duration-150 hover:text-accent"
                  >
                    {sample.title}
                  </a>
                  {repo.stats && (
                    <span class="text-sm text-muted-foreground">
                      {formatStats(repo.stats)}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm text-muted-foreground">
                  {sample.tagline}
                </p>
                {post && (
                  <p class="mt-1 text-sm">
                    <span class="text-muted-foreground">Post: </span>
                    <a
                      href={post.postUrl}
                      class="text-accent transition-colors duration-150 hover:text-accent-hover"
                    >
                      {post.title}
                    </a>
                  </p>
                )}
              </li>
            )
          })
        }
      </ul>
    </section>
  </div>
</BaseLayout>
