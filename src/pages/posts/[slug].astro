---
import { getCollection, getEntry, render } from "astro:content"
import CodeCopy from "@/components/CodeCopy.astro"
import Image from "@/components/Image.astro"
import Link from "@/components/Link.astro"
import Mermaid from "@/components/Mermaid.astro"
import Parts from "@/components/Parts.astro"
import PostTags from "@/components/PostTags.astro"
import RelatedPosts from "@/components/RelatedPosts.astro"
import TOC from "@/components/TOC.astro"
import TableWrapper from "@/components/TableWrapper.astro"
import YoutubeVideo from "@/components/YoutubeVideo.astro"
import siteMetadata from "@/config/siteMetadata"
import BaseLayout from "@/layouts/BaseLayout.astro"
import PostSimple from "@/layouts/PostSimple.astro"
import { getAllPosts, getPublishedPosts } from "@/lib/posts"
import { genPostMetadata } from "@/lib/seo"
import { getRelatedPosts } from "@/lib/tag-utils"
import { headingsToToc } from "@/lib/toc"
import type { GetStaticPaths } from "astro"

export const getStaticPaths = (async () => {
  const published = await getPublishedPosts()
  return published.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Sorted newest first: "next" is the newer post.
      next: published[i - 1],
      prev: published[i + 1],
    },
  }))
}) satisfies GetStaticPaths

const { post, next, prev } = Astro.props
const entry = (await getCollection("posts")).find((e) => e.id === post.slug)
if (!entry) throw new Error(`Missing post entry ${post.slug}`)
const { Content, headings } = await render(entry)
const toc = headingsToToc(headings)
const relatedPosts = getRelatedPosts(await getAllPosts(), post.slug)

const authorDetails = await Promise.all(
  (post.authors.length ? post.authors : ["default"]).map(
    async (id) =>
      (await getEntry("authors", id))?.data ?? { name: "Default Author" }
  )
)

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  author: authorDetails.map((author) => ({
    "@type": "Person",
    name: author.name,
  })),
  datePublished: post.date,
  dateModified: post.lastmod || post.date,
  image: post.images[0] || `/og/${post.slug}.png`,
  url: `${siteMetadata.siteUrl}/posts/${post.slug}`,
}

// MDX tags used in posts. `<Content />` gets no props, so `props.toc`,
// `props.videoId` and `props.slug` are undefined inside posts and those tags
// render nothing, as on the previous site; the video and TOC are rendered
// above the post body instead.
const components = {
  a: Link,
  table: TableWrapper,
  Image,
  TOCInline: TOC,
  YoutubeVideo,
  Parts,
}
---

<BaseLayout meta={genPostMetadata(post)}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <PostSimple
    content={post}
    next={next ? { postUrl: next.postUrl, title: next.title } : undefined}
    prev={prev ? { postUrl: prev.postUrl, title: prev.title } : undefined}
  >
    <PostTags tags={post.tags} />

    <div class="mdx-content">
      {
        post.series && (
          <div class="mb-6 rounded-lg border border-accent/30 bg-accent-muted/30 p-4">
            <h3 class="mb-2 text-lg font-semibold text-foreground">
              Series: {post.series}
            </h3>
            <p class="text-muted-foreground">
              This post is part of the {post.series} series.
            </p>
          </div>
        )
      }

      {
        post.videoId && (
          <div class="mb-8">
            <YoutubeVideo videoId={post.videoId} />
          </div>
        )
      }

      {
        toc.length > 0 && (
          <div class="mb-8">
            <TOC toc={toc} />
          </div>
        )
      }

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <Content components={components} />
      </div>
    </div>

    <RelatedPosts posts={relatedPosts} />
  </PostSimple>
  <CodeCopy />
  <Mermaid />
</BaseLayout>
