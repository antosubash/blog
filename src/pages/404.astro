---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout>
  <section class="mx-auto max-w-4xl px-5 sm:px-6">
    <div
      class="flex flex-col items-start justify-start md:mt-24 md:flex-row md:items-center md:justify-center md:gap-6"
    >
      <div class="pb-8 pt-6">
        <h1
          class="text-6xl font-extrabold tracking-tight text-foreground md:border-r-2 md:border-border md:pr-6 md:text-8xl"
        >
          404
        </h1>
      </div>
      <div class="max-w-md">
        <p class="mb-4 text-xl font-bold text-foreground md:text-2xl">
          Sorry we couldn&apos;t find this page.
        </p>
        <p class="mb-8 text-muted-foreground">
          But don&apos;t worry, you can find plenty of other things on our
          homepage.
        </p>
        <a
          href="/"
          class="inline rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70"
        >
          Back to homepage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
